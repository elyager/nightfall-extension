{
  "name": "nightfall-extension",
  "description": "Comfortable dark mode, one site at a time. Adjust image brightness and keep your favorite sites easy to read.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "puppeteer-core": "^25.5.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wxt": "^0.21.3"
  }
}
